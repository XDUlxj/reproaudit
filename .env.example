# 密钥仅放本地 .env，不提交版本库
GLM_API_KEY=
GLM_MODEL=glm-4.5-air
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TAVILY_API_KEY=
DATABASE_URL=postgresql://scitrace:YOUR_PASSWORD@localhost:5432/scitrace
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 正式运行建议设置为 Hugging Face 不可变 commit；修改后使用独立索引集合
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
ARTIFACT_ROOT=artifacts
DOCKER_IMAGE=scitrace-runner:0.1
MAX_STEPS=24
SPECIALIST_STEPS=10
MODEL_TIMEOUT=90
DOWNLOAD_LIMIT_MIB=500
MAX_DOCUMENT_MIB=50
MAX_CHUNKS=20000
# 仅当本机代理把域名映射到 198.18.0.0/15 时，明确列出可信域名。
# 默认 [] 严格阻止所有保留地址；此选项不允许 127.0.0.1、10/8 等内网地址。
TRUSTED_FAKE_DNS_HOSTS=[]
